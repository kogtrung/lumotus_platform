# ============================================================
# Lumotus — Environment Variables Template
# Copy file này thành .env và điền giá trị thực tế
# KHÔNG commit file .env lên Git
# ============================================================

# ── Spring Profile ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumotus
DB_USER=lumotus_user
DB_PASSWORD=changeme

# ── pgAdmin (docker-compose --profile tools) ─────────────────
PGADMIN_EMAIL=admin@lumotus.dev
PGADMIN_PASSWORD=admin

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────
# Tạo secret: openssl rand -base64 64
JWT_SECRET=change-this-secret-key-at-least-256-bits-long-please-replace-me
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_DAYS=7

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:8080

# ── Cloudinary (Media Storage) ────────────────────────────────
# Đăng ký miễn phí: https://cloudinary.com
# Free tier: 25 GB storage + 25 GB bandwidth/tháng
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── AI Provider ──────────────────────────────────────────────
# openai hoặc claude
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
# CLAUDE_API_KEY=sk-ant-...
